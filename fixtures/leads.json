[
  {
    "id": "clean-web-form",
    "about": "A clean lead from a website form. The baseline everything else is compared to.",
    "input": { "first_name": "Maria", "last_name": "Lopez", "email": "maria.lopez@example.com", "phone": "(202) 555-0143", "source": "Website" },
    "expect": {
      "status": "clean",
      "issues": [],
      "lead": { "firstName": "Maria", "greetingName": "Maria", "phone": "+12025550143", "phoneDisplay": "(202) 555-0143", "source": "Website" },
      "channels": { "call": true, "text": true, "email": true }
    }
  },
  {
    "id": "phone-with-country-code",
    "about": "Phone typed with +1 and dashes.",
    "input": { "firstName": "Derek", "lastName": "Shaw", "email": "derek.shaw@example.org", "phone": "+1 202-555-0178" },
    "expect": { "status": "clean", "issues": [], "lead": { "phone": "+12025550178" } }
  },
  {
    "id": "phone-with-extension",
