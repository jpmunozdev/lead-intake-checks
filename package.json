    "build": "node scripts/build-n8n.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "lead",
    "crm",
    "n8n",
    "gohighlevel",
    "phone-validation",
    "email-validation",
    "deduplication",
    "speed-to-lead"
  ],
